rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function isOwnerEmail() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'giathieu110406@gmail.com';
    }

    function isAdminDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdminRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isAdmin() {
      return isOwnerEmail() || isAdminDoc() || isAdminRole();
    }

    // Owner: full access ngoại trừ profiles và OTP records, vốn cần các ràng buộc riêng.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'email_verifications' && collection != 'users' && isOwnerEmail();
    }

    match /email_verifications/{uid} {
      allow read, write: if false;
    }

    // Collection admins: chỉ đọc được nếu là admin, không ai write được từ client
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get:    if isSignedIn() && (currentUid() == userId || isAdmin());
      allow list:   if isAdmin();
      allow create: if isSignedIn() && request.resource.data.get('emailOtpVerifiedAt', null) == null && (
        isAdmin() || (
          currentUid() == userId &&
          request.resource.data.get('role', 'user') == 'user' &&
          request.resource.data.get('status', 'pending') == 'pending'
        )
      );
      allow update: if isSignedIn() && request.resource.data.get('emailOtpVerifiedAt', null) == resource.data.get('emailOtpVerifiedAt', null) && (
        isAdmin() || (
          currentUid() == userId &&
          request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
          request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
        )
      );
      allow delete: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      allow create: if isSignedIn();
      allow read:   if isSignedIn() && (resource.data.uid == currentUid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read:   if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    match /saved_documents/{documentId} {
      allow create: if isSignedIn() && (request.resource.data.userId == currentUid() || isAdmin());
      allow read:   if isSignedIn() && (resource.data.userId == currentUid() || isAdmin());
      allow update: if isSignedIn() && resource.data.userId == currentUid() && request.resource.data.userId == currentUid();
      allow delete: if isSignedIn() && (resource.data.userId == currentUid() || isAdmin());
    }

    match /api_usage_stats/{statId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /raw_ai_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /ai_insights/{insightId} {
      allow read, write: if isAdmin();
    }

    match /system_prompts/{promptId} {
      allow read: if isSignedIn(); // In case client needs it, though server usually fetches it
      allow write: if isAdmin();
    }
  }
}
