{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/webhook/payos",
      "destination": "https://word2latexbackend-341505323323.asia-southeast1.run.app/api/payos-webhook"
    },
    {
      "source": "/api/:match*",
      "destination": "https://word2latexbackend-341505323323.asia-southeast1.run.app/api/:match*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
